{
  "name": "geo-explorer-mcp",
  "version": "1.0.0",
  "description": "MCP Server do Geo-Explorer \u2014 exp\u00f5e trilhas, desafios e certificados via protocolo MCP (stdio)",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "geo-explorer-mcp": "./build/index.js"
  },
  "files": ["build"],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.default.chmodSync('build/index.js', '755'))\"",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
